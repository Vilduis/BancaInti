@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <i class="bi bi-exclamation-triangle display-4 text-danger"></i>
    <h1 class="h4 mt-3">Ocurrió un error al procesar su solicitud</h1>
    <p class="text-muted">Intente nuevamente. Si el problema continúa, comuníquese con el área de Tecnología.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código de referencia: <code>@Model.RequestId</code></p>
    }
    <a href="~/" class="btn btn-primary">Ir al inicio</a>
</div>
