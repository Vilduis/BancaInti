@model List<PeriodoEstrategico>
@{
    ViewData["Title"] = "Periodos estratégicos";
    ViewData["Seccion"] = "Configuración";
    ViewData["Descripcion"] = "Horizonte de varios años (plan estratégico) que agrupa los periodos operativos de evaluación.";
}

@section Acciones {
    <a class="btn btn-primary" asp-action="Create" data-modal><i class="bi bi-plus-lg"></i> Nuevo periodo</a>
}

<div class="card tabla-card">
    <table class="table table-hover align-middle" data-tabla="Periodos estratégicos">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Periodos operativos</th>
                <th class="no-exportar"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-medium">@p.Nombre</td>
                    <td data-order="@p.FechaInicio.ToString("yyyy-MM-dd")">@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td data-order="@p.FechaFin.ToString("yyyy-MM-dd")">@p.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>@string.Join(", ", p.PeriodosOperativos.OrderBy(o => o.Anio).Select(o => o.Anio))</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="PeriodosOperativos" asp-action="Create" asp-route-estrategicoId="@p.Id" title="Agregar periodo operativo" data-modal><i class="bi bi-calendar-plus"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id" title="Editar" data-modal><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirm="¿Eliminar el periodo @p.Nombre?">
                            <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
