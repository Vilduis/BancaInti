@model PeriodoOperativoForm
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo periodo operativo" : "Editar periodo operativo";
    ViewData["Seccion"] = "Configuración";
    ViewData["Descripcion"] = "Año de evaluación dentro de un periodo estratégico.";
}

<form asp-action="Save" method="post" class="form-modal">
    <div class="form-modal-cuerpo">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-8 mb-3">
                <label asp-for="PeriodoEstrategicoId" class="form-label"></label>
                <select asp-for="PeriodoEstrategicoId" asp-items="ViewBag.Estrategicos" class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Anio" class="form-label"></label>
                <input asp-for="Anio" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col mb-3">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio" type="date" class="form-control" />
            </div>
            <div class="col mb-3">
                <label asp-for="FechaFin" class="form-label"></label>
                <input asp-for="FechaFin" type="date" class="form-control" />
            </div>
        </div>

        <div>
            <label asp-for="MensajeColaborador" class="form-label"></label>
            <textarea asp-for="MensajeColaborador" class="form-control" rows="3" placeholder="@PeriodoOperativo.MensajePorDefecto"></textarea>
            <div class="form-text">Texto plano que ve el colaborador al ingresar. Si se deja vacío se usa el mensaje del ejemplo.</div>
        </div>
    </div>
    <div class="form-modal-pie">
        <a asp-action="Index" class="btn btn-light" data-cancelar>Cancelar</a>
        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
    </div>
</form>
